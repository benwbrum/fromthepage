\section{<%= Work::Export::Lib::Utils.latex_escape(work.title) %>}
\label{<%= work.title.downcase %>}

<%= render partial: 'shared/printable/newpage' %>

<% if include_metadata %>
  \subsection{<%= t('export.facing_edition.metadata') %>}
  \label{<%= t('export.facing_edition.metadata').downcase %>}

  <%= t('export.facing_edition.export_metadata',
    work: Work::Export::Lib::Utils.latex_escape(work.title),
    collection: Work::Export::Lib::Utils.latex_escape(collection.title),
    time: Work::Export::Lib::Utils.latex_escape(time.to_s)) %>

  <% work.merge_metadata.each do |metadata| %>
    <%= Work::Export::Lib::Utils.latex_escape("#{metadata['label']}: #{metadata['value']}") %>

  <% end %>

  <%= render partial: 'shared/printable/newpage' %>
<% end %>
