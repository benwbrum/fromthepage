\subsubsection{<%= t('export.facing_edition.notes') %>}
\label{<%= "#{page.title} notes" %>}

\begin{small}
<% notes.each do |note| %>
  <% raw_note = '<div><p>' + note.user.display_name + ': ' + note.body + '</p></div>' %>
  <% raw_note = raw_note.gsub("\n", '<lb/>') %>
  <% raw_note = raw_note.gsub(/&(?!amp;|lt;|gt;|quot;|apos;|#\d+;|#x[0-9A-Fa-f]+;)/, '&amp;') %>
  <% converted_note = Work::Export::Lib::Utils.xml_to_latex(page: note, xml_text: raw_note, preserve_lb: @preserve_lb, flatten_links: true) %>
  <%= "\\hspace*{0.5em}\\textit{#{converted_note}} \\\\" %>

<% end %>
\end{small}
