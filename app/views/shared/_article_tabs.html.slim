-tabs = [{\
  :name => t('.overview'),
  :selected => 1,
  :path => "#{collection_article_show_path(@collection.owner, @collection, @article)}",
}]

-if user_signed_in? && !current_user.guest && notes_visible?(@collection, current_user)
  -tabs += [{\
    :name => t('.settings'),
    :selected => 4,
    :path =>"#{collection_article_edit_path(@collection.owner, @collection, @article)}",
  }]

-if notes_visible?(@collection, current_user)
  -tabs += [{\
    :name => t('.versions'),
    :selected => 2,
    :path => "#{collection_article_version_path(@collection.owner, @collection, @article)}",
  }]

-description = cached_article_xml_to_html(@article, collection: @collection)
-selected_tab = tabs.find { |tab| tab[:selected] == selected }[:name] rescue ""
-display_title = @article.errors[:title].present? ? @article.title_in_database : @article.title
-content_for :page_title, selected == 1 ? display_title : "#{selected_tab} - #{display_title}"
-content_for :meta_description, "#{display_title} - #{t('.subject')} #{selected_tab.downcase}. #{strip_tags(description).truncate(150, separator: ' ')}"

h1[*language_attrs(@collection)] =display_title
.tabs
  -for tab in tabs
    -if tab[:path]
      =link_to_unless tab[:selected] == selected, tab[:name], tab[:path]
        a.active =tab[:name]
    -else
      =link_to_unless tab[:selected] == selected, tab[:name], tab[:options].merge(:article_id => article_id)
        a.active =tab[:name]
