<% if @result.success? %>
  <% if SMTP_ENABLED %>
    <% if @document_upload.generate_ai_draft %>
      <% flash_msg = t('.document_uploaded_with_ai', email: @document_upload.user.email) %>
    <% else %>
      <% flash_msg = t('.document_uploaded', email: @document_upload.user.email) %>
    <% end %>
  <% else %>
    <% if @document_upload.generate_ai_draft %>
      <% flash_msg = t('.reload_this_page_with_ai') %>
    <% else %>
      <% flash_msg = t('.reload_this_page') %>
    <% end %>
  <% end %>

  <% if @document_upload.document_set_id.present? %>
    <%= turbo_stream.redirect(
      collection_path(@document_upload.collection.owner, @document_upload.document_set),
      response: turbo_flash(flash_msg, :info)
    )%>
  <% else %>
    <%= turbo_stream.redirect(
      collection_show_path(collection_id: @document_upload.collection_id),
      response: turbo_flash(flash_msg, :info)
    )%>
  <% end %>
<% else %>
  <%= turbo_flash(t('errors.error'), :error) %>
  <%= turbo_stream.replace('document_upload_form', partial: 'dashboard/upload') %>
<% end %>
