<% if @result.success? %>
  <% if @work.document_sets.any? %>
    <% redirect_url = pages_collection_work_path(@work.owner, @work.document_sets.first, @work, anchor: 'create-page') %>
  <% else %>
    <% redirect_url = work_pages_tab_path(work_id: @work.id, anchor: 'create-page') %>
  <% end %>

  <%= turbo_stream.redirect(
    redirect_url,
    response: turbo_flash(t('.work_created'), :notice)) %>
<% else %>
  <%= turbo_flash(t('errors.error'), :error) %>
  <%= turbo_stream.replace('empty_work_form', partial: 'dashboard/empty') %>
<% end %>
