<%= turbo_stream.update('statistics-table', partial: 'statistics/in_date_range', locals: {
  dated_statistics_object: @dated_statistics_object, subjects_disabled: @subjects_disabled,
  supports_translation: @supports_translation, supports_ocr: @supports_ocr
}) %>

<%= turbo_stream.replace('range-label') do %>
  <%= content_tag(:h2, t('statistics.statistics.statistics_from', start_date: l(@start_date.to_date), end_date: l(@end_date.to_date)), id: 'range-label') %>
<% end %>

<%= turbo_stream.replace('collaborator-time', partial: 'statistics/collaborator_time') %>
