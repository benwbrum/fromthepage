#ia_upload_form.my-3[data-controller='toggle-view']
  h3
    =link_to t('.import_from_the_internet_archive'), '#', class: 'title', id: 'import-internet-archive', data: { action: 'click->toggle-view#toggle' }

  section[data-toggle-view-target='toggleable' style='display: none']
    =label_tag :ia_url, t('.paste_in_the_url')
    =form_tag(sc_collections_import_ia_path) do |f|
      table.form
        td
          .input-file
            =text_field_tag :ia_url
            -if @collection
              =hidden_field_tag :collection_id, @collection.slug
            =button_tag t('.import'), id: 'ia_import'
