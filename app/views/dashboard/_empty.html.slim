#empty_work_form.my-3[data-controller='toggle-view']
  h3
    =link_to t('.create_empty_work'), '#', class: 'title', id: 'create-empty-work', data: { action: 'click->toggle-view#toggle' }

  section[data-toggle-view-target='toggleable' style="#{@work.errors.any? ? '' : 'display: none'}"]
    p.big =t('.create_empty_work_description')
    =form_for :work, url: dashboard_create_work_path, html: { data: { turbo: true } } do |f|
      =validation_summary @work.errors
      table.form
        tr
          td
            =f.label :collection_id, class: "hidden"
            =f.select :collection_id,
              options_for_select(collections_and_document_sets_options, selected: @work.document_sets.first&.slug || @work.collection&.slug),
              { include_blank: true },
              { style: 'width: 100%', data: { controller: 'select2', select2_placeholder_value: t('.select_a_collection') } }
        tr
          td
            =f.label :title, class: "hidden"
            =f.text_field :title, placeholder: t('.title')
        tr
          td(colspan="2")
            =f.label :description, class: "hidden"
            =f.text_area :description, rows: 4, placeholder: t('.description')
            br: i =t('.description_message')
      .toolbar
        .toolbar_group.aright =f.button t('.create_work')
