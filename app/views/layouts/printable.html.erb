\ifdefined\DocumentMetadata
\DocumentMetadata{
  lang=en,
  pdfversion=1.7,
  pdfstandard=ua-1,
<% if @work %>
  pdftitle={<%= Work::Export::Lib::Utils.latex_escape(@work.title) %>},
<% end %>
}
\fi
\documentclass{article}

<%= render partial: 'shared/printable/packages' %>

<%= render partial: 'shared/printable/configurations' %>

<% if @work %>
\hypersetup{pdftitle={<%= Work::Export::Lib::Utils.latex_escape(@work.title) %>}}
<% end %>

\begin{document}

<% if @edition_type != 'text_only' %>
  <%= render partial: 'shared/printable/headers', locals: { work: @work, collection: @collection, include_metadata: @include_metadata, time: @time } %>
<% end %>

<%= yield %>

\end{document}
