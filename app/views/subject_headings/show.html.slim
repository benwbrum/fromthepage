.litebox-embed.subject-heading-configuration
  h3 Configure Subject Headings
  p.fgfaded =@field.label
  -if @error
    .validation role="alert"
      ul.validation_summary
        li =@error
  =form_tag collection_subject_headings_path(@collection.owner, @collection, @field), method: :patch, multipart: true do
    section.subject-heading-section aria-labelledby="subject-heading-file-title"
      h4#subject-heading-file-title =label_tag :file, 'Subject headings file'
      -if @inventory
        .subject-heading-file-summary
          p
            strong = 'Current file: '
            =@inventory.filename
          p ="#{@inventory.row_count} imported rows; #{@inventory.subject_headings.count} unique headings."
      .input-file data-controller="file-picker"
        =file_field_tag :file, accept: '.csv,text/csv', required: @inventory.nil?, 'aria-describedby': 'subject-heading-file-help'
        input type="text" placeholder="Click to browse a file" aria-label="Selected subject headings file" readonly=true
        button type="button" Browse
      p#subject-heading-file-help.fgfaded CSV with a heading column and an optional uri column. Maximum 5 MB (16 MB for a validation report) and 10,000 rows.
      p =link_to 'Download CSV template', collection_subject_headings_template_path(@collection.owner, @collection, @field)
      -if @inventory
        p Replacing this file changes which headings are available for future assignments. Headings already saved to item descriptions will not be changed.

    section.subject-heading-section aria-labelledby="subject-heading-guidelines-title"
      h4#subject-heading-guidelines-title =label_tag :instructions, 'Subject assignment guidelines (optional)'
      p#subject-heading-guidelines-help.fgfaded Describe how subject headings should be assigned to documents in this collection. These guidelines will be used by AI Draft Metadata.
      =text_area_tag :instructions, params[:instructions] || @field.subject_heading_instructions, rows: 5, maxlength: 20_000, 'aria-describedby': 'subject-heading-guidelines-help', placeholder: 'Assign headings that describe the main subjects of each document. Prefer specific headings when supported by the transcription. Do not assign headings for people or places mentioned only in passing.'

    section.subject-heading-section aria-labelledby="subject-heading-authority-title"
      h4#subject-heading-authority-title Authority check
      .subject-heading-check
        =check_box_tag :validate_authorities, '1', false, 'aria-describedby': 'subject-heading-authority-help'
        =label_tag :validate_authorities, 'Check for matches in Library of Congress authority records'
      p#subject-heading-authority-help.fgfaded The check produces a downloadable report with possible matches and suggested identifiers. It never automatically changes your uploaded headings.
      -if @inventory
        p ="Validation status: #{@inventory.validation_status.humanize}"
        -if @inventory.validation_error.present?
          .validation role="alert"
            ul.validation_summary
              li =@inventory.validation_error.gsub(/\binventory\b/i, 'heading list')
        -if @inventory.report_csv.present?
          p =link_to 'Download validation report', collection_subject_headings_report_path(@collection.owner, @collection, @field)
          p To adopt suggestions, edit the heading and uri columns in the report and upload the revised file.
        -if @inventory.validation_retryable?
          =button_tag 'Check authorities again', type: 'submit', form: 'subject-heading-authority-retry'

    .toolbar
      .toolbar_group.aright.wrap-text
        -if request.xhr?
          =button_tag 'Cancel', type: 'reset'
        -else
          =link_to 'Cancel', collection_edit_metadata_fields_path(@collection.owner, @collection), class: 'button'
        | &nbsp;
        =button_tag 'Save Subject Headings', type: 'submit'
  -if @inventory&.validation_retryable?
    =form_tag collection_subject_headings_retry_path(@collection.owner, @collection, @field), id: 'subject-heading-authority-retry' do
      =hidden_field_tag :field_id, @field.id
