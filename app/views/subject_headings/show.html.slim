.litebox-embed.subject-heading-modal data-controller="subject-headings"
  =render 'subject_headings/modal_header', title: 'Configure Subject Headings', subtitle: @field.label
  =form_tag collection_subject_headings_path(@collection.owner, @collection, @field), method: :patch, multipart: true do
    .subject-heading-modal_body
      section.subject-heading-section aria-labelledby="subject-heading-file-title"
        h4#subject-heading-file-title =label_tag :file, 'Subject Headings File'
        -if @inventory
          .subject-heading-summary.subject-heading-file-summary
            strong =@inventory.filename
            p.fgfaded
              ="#{pluralize(number_with_delimiter(@inventory.row_count), 'row')} · #{pluralize(number_with_delimiter(@inventory.unique_count), 'unique heading')}"
              -if @inventory.duplicate_count.positive?
                =" · #{pluralize(number_with_delimiter(@inventory.duplicate_count), 'duplicate row')} merged"
        =render 'subject_headings/file_input', required: @inventory.nil?, label: true
        p.fgfaded
          | To check for duplicates and the headings against Library of Congress authority records before uploading, use&nbsp;
          =link_to 'Validate Subject Headings', collection_new_subject_headings_validation_path(@collection.owner, @collection, @field), data: { action: 'subject-headings#swap' }
          |  first.
        -if @inventory
          p.fgfaded Replacing this file changes which headings are available for future assignments. Headings already saved to item descriptions will not be changed.

      section.subject-heading-section aria-labelledby="subject-heading-guidelines-title"
        h4#subject-heading-guidelines-title =label_tag :instructions, 'Subject Assignment Guidelines (optional)'
        p#subject-heading-guidelines-help Describe how subject headings should be assigned to documents in this collection. These guidelines will be used by AI Draft Metadata.
        =text_area_tag :instructions, params[:instructions] || @field.subject_heading_instructions, rows: 5, maxlength: 20_000, 'aria-describedby': 'subject-heading-guidelines-help', placeholder: 'Assign headings that describe the main subjects of each document. Prefer specific headings when supported by the transcription. Do not assign headings for people or places mentioned only in passing.'

    .subject-heading-modal_footer.toolbar
      .toolbar_group.aright.wrap-text
        =render 'subject_headings/cancel_button'
        =button_tag 'Save Subject Headings', type: 'submit'
