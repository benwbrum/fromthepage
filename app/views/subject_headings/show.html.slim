.litebox-embed
  h3 Configure Subject Headings
  h4 =@field.label
  -if @error
    p.fgerror role="alert" =@error
  -if @inventory
    p
      strong = 'Current inventory: '
      =@inventory.filename
    p ="#{@inventory.row_count} imported rows; #{@inventory.subject_headings.count} unique headings."
    p Exact duplicates and headings differing only by one final period share an option when their URIs are identical. The first spelling is retained.
    p ="Validation status: #{@inventory.validation_status.humanize}"
    -if @inventory.validation_error.present?
      p.fgerror =@inventory.validation_error
    -if @inventory.report_csv.present?
      p =link_to 'Download validation report', collection_subject_headings_report_path(@collection.owner, @collection, @field)
      p No suggested changes have been applied. To adopt suggestions, edit the heading and uri columns and reupload the CSV. Other columns are ignored.
    -if @inventory.validation_retryable?
      =button_to 'Check authorities again', collection_subject_headings_retry_path(@collection.owner, @collection, @field), method: :post
  =form_tag collection_subject_headings_path(@collection.owner, @collection, @field), method: :patch, multipart: true do
    p =link_to 'Download example CSV template', collection_subject_headings_template_path(@collection.owner, @collection, @field)
    =label_tag :file, @inventory ? 'Replace CSV inventory' : 'CSV inventory'
    =file_field_tag :file, accept: '.csv,text/csv', required: @inventory.nil?
    p Upload a CSV file with a heading column and optional uri column. Only HTTP/HTTPS URIs are supported. Maximum 5 MB for an inventory, 16 MB for a validation report, and 10,000 rows. Existing item descriptions are preserved when the inventory is replaced.
    =label_tag :instructions, 'Instructions for AI Draft Metadata'
    =text_area_tag :instructions, params[:instructions] || @field.subject_heading_instructions, rows: 8, maxlength: 20_000
    p Paste document guidance here. Guidance document attachments are not currently supported.
    p
      =check_box_tag :validate_authorities, '1', false
      =label_tag :validate_authorities, 'Check headings against Library of Congress authorities'
    p Validation is advisory and applies to the uploaded CSV. Possible authorized forms and identifiers appear in a report; uploaded headings are never changed automatically. Unmatched headings remain in the inventory.
    .toolbar
      .toolbar_group.aright
        =submit_tag @inventory ? 'Save / Import Headings' : 'Import Headings'
  p =link_to 'Return to metadata fields', collection_edit_metadata_fields_path(@collection.owner, @collection)
