=render partial: 'admin/header', locals: { selected: Admin::Ai::BaseController::ADMIN_HEADER_TAB }

.collection-meta-wrapper
  =render partial: 'admin/ai/side_nav', locals: { current_section: :suspicious_behaviors }
  #collection-settings
    =fe_filter_table_wrapper(selector: 'suspicious-behaviors-table') do
      =fe_filter_form_wrapper(url: admin_ai_suspicious_behaviors_path, selector: 'suspicious-behaviors-table', sorting: @sorting, ordering: @ordering) do
        =fe_filter_search(key: :search_user, value: params[:search_user], placeholder: t('filter_table.search_user'), label: t('filter_table.user'), classes: 'float-left')
        =fe_filter_search(key: :search_collection, value: params[:search_collection], placeholder: t('filter_table.search_collection'), label: t('filter_table.collection'), classes: 'float-left')
        =fe_filter_search(key: :search_owner, value: params[:search_owner], placeholder: t('filter_table.search_owner'), label: t('filter_table.owner'), classes: 'float-left')
        =fe_filter_select(key: :status, value: params[:status] || 'pending', options: suspicious_behavior_status_options, label: t('suspicious_behaviors.labels.status'))
        =fe_filter_select(key: :behavior_type, value: params[:behavior_type] || 'all', options: suspicious_behavior_type_options, label: t('suspicious_behaviors.labels.behavior_type'))

      =fe_filter_table(selector: 'suspicious-behaviors-table') do
        =render partial: 'table'
