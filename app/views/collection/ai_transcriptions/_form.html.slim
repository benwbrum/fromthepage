-status = @status || AiSettingsStatus.new(collection)
.collection-settings-wrapper.ai-settings data-controller=(status.running? ? 'auto-refresh' : nil) data-auto-refresh-url-value=edit_collection_ai_transcriptions_path(collection.owner, collection)
  -if current_user.individual_researcher?
    section.ai-settings_section
      h3 =t('.ai_transcription')
      p =t('.contact_us', email: mail_to(SUPPORT_EMAIL)).html_safe
  -else
    =render 'collection/ai_transcriptions/transcription', collection: collection, status: status
    -if ai_work_metadata_form_available?(collection)
      #ai-work-metadata-settings
        =render 'collection/ai_work_metadata/form', collection: collection, status: status
