-content_for :page_title, t('.title')

section.signon
  h1 =t('.title')
  -if current_user
    p =t('.manual_recovery')
  -else
    p =@resume_recovery_id ? t('.resume_explanation') : t('.explanation')
    p =link_to t('.sign_in'), new_user_session_path, class: 'button big', target: '_blank', rel: 'noopener noreferrer'
  -if @recovery_editor_path
    p =link_to t('.open_editor'), @recovery_editor_path, class: 'button outline', data: { turbo: false }
  .signon_field
    =label_tag :submitted_text, t('.submitted_text')
    =text_area_tag :submitted_text, @submitted_text, readonly: true, rows: 12
  -if @submitted_fields
    .signon_field
      =label_tag :submitted_fields, t('.submitted_fields')
      =text_area_tag :submitted_fields, @submitted_fields, readonly: true, rows: 12
