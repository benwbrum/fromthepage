h2 Subject heading validation
p ="Project: #{@collection.title} — #{@field.label} · #{@validation.filename}"
-if (counts = @validation.counts)
  p ="#{number_with_delimiter(counts[:total])} headings were checked against Library of Congress authority records. Your headings have not been changed."
  ul
    li ="#{number_with_delimiter(counts[:exact])} exact matches"
    li ="#{number_with_delimiter(counts[:possible])} possible matches to review"
    -if counts[:errors].positive?
      li ="#{number_with_delimiter(counts[:errors])} lookup errors"
  p Suggestions are advisory. No headings are saved to this field until you upload a file in Configure Subject Headings.
-else
  p Validation failed and no report could be produced. Please validate the file again.
p =link_to 'Review Validation', @review_url
