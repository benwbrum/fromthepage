h2 Subject headings authority check
p ="Project: #{@collection.title} — #{@field.label}"
p =@inventory.authority_check_title
-if @inventory.authority_check_outcome == 'failed'
  p No usable authority check report could be produced. Your uploaded headings remain available. Retry the authority check from the configuration screen.
-else
  p =@inventory.authority_check_summary
  p Suggestions are advisory. A completed check does not mean every heading is approved or appropriate for your collection.
  p =link_to 'Download authority check report', collection_subject_headings_report_url(@collection.owner, @collection, @field)
p =SubjectHeadings::Report::REUPLOAD_INSTRUCTIONS
p =link_to 'Configure Subject Headings', @configuration_url
