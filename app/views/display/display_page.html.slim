-# Meta tags for better archival and SEO
-content_for :page_title, @page_title if @page_title
-content_for :meta_description, @meta_description if @meta_description
-content_for :meta_keywords, @meta_keywords if @meta_keywords

-# Structured data for better content understanding by crawlers
-if @structured_data
  script type="application/ld+json"
    =raw @structured_data.to_json

-if current_page?(collection_forum_page_path(@collection.owner, @collection, @page.work, @page))
  =render({ :partial => '/shared/collection_tabs', :locals => { :selected => 14, :collection_id => @collection.id }})
  =render('thredded/shared/breadcrumbs')
-else
  =render({ :partial => '/shared/page_tabs', :locals => { :selected => 1, :page_id => @page.id }})

.page-headlines
  .headline
    h3.headline_title =t('.facsimile')
  -if @overview_layout_mode == 'ltr'
    .headline
      -if translation_mode?
        h3.headline_title =t('.translation')
        .page_status
          =t("page.edit.status")
          =t("page.edit.page_status_#{@page.translation_status}")
        small.headline_aside =link_to t('.show_transcription'), collection_display_page_path(@collection.owner, @collection, @work, @page.id, translation: false), class: 'button outline'
      -else
        h3.headline_title =t('.transcription')
        .page_status
          =t("page.edit.status")
          =t("page.edit.page_status_#{@page.status}")

        -if @work.supports_translation
          small.headline_aside =link_to t('.show_translation'), collection_display_page_path(@collection.owner, @collection, @work, @page.id, translation: true), class: 'button outline'

.page-columns(data-layout-mode="#{@overview_layout_mode}")
  .page-column(id="leftColumn")
    .page-imagescan
      =render :partial => '/shared/osd_div'
  .splitter(id="splitter")
  .page-column(id="rightColumn")
    -if @overview_layout_mode == 'ttb'
      .headline
        -if translation_mode?
          h3.headline_title =t('.translation')
          .page_status
            =t("page.edit.status")
            =t("page.edit.page_status_#{@page.translation_status}")
          small.headline_aside =link_to t('.show_transcription'), collection_display_page_path(@collection.owner, @collection, @work, @page.id, translation: false), class: 'button outline'
        -else
          h3.headline_title =t('.transcription')
          .page_status
            =t("page.edit.status")
            =t("page.edit.page_status_#{@page.status}")

          -if @work.supports_translation
            small.headline_aside =link_to t('.show_translation'), collection_display_page_path(@collection.owner, @collection, @work, @page.id, translation: true), class: 'button outline'
    .page-preview[*language_attrs(@collection)]
      -if translation_mode?
        -text = xml_to_html(@page.xml_translation)
        -action = 'translate'
        -help_word = t('.help_translate')
        -text_type = t('.translated')

      -elsif correction_mode?
        -text = xml_to_html(@page.xml_text)
        -action = 'display_page'
        -help_word = t('.help_correct')
        -text_type = t('.corrected')

      -else
        -text = xml_to_html(@page.xml_text)
        -action = 'display_page'
        -help_word = t('.help_transcribe')
        -text_type = t('.transcribed')

      -mark_blank = link_to(t('.mark_the_page_blank'), transcribe_mark_page_blank_path(page_id: @page.id), data: { turbo: true, turbo_method: :post, turbo_stream: true })

      -if @page.status_blank?
        .centered
          .centered_content
            p.nodata_text==t('.this_page_is_blank')
      -elsif text.present?
        ==text
      -else
        .centered
          .centered_content
            -if @collection.active? # Inactive Collections shouldn't display this stuff
              h5.nodata_title =t('.this_page_is_not', text_type: text_type)
              p.nodata_text
                -if current_user && current_user.can_transcribe?(@page.work, @collection)
                  -help_link = link_to(help_word, { :controller => 'transcribe', :action => action, :page_id => @page.id })
                  ==t('.please_help_this_page', help_link: help_link)
                  ==t('.or_mark_blank', mark_blank: mark_blank) unless @page.status_blank?
                -elsif !current_user && !@page.work.restrict_scribes
                  -help_link = link_to(help_word, transcribe_guest_path(:page_id => @page.id))
                  ==t('.please_help_this_page', help_link: help_link)
                -else
                  ==t('.collaboration_is_restricted')
            -else
              ==t('.collection_is_not_active')

-if @collection.legend.present?
  .page-legend
    h2.page-legend-title =t('.legend')
    .page-legend-content
      ==@collection.legend

-unless @collection.hide_notes? && !(current_user && (current_user.like_owner?(@collection) || current_user.collaborator?(@collection)))
  h2.legend#notes =t('.page_notes')
  .page-notes
    =render :partial => "notes/notes"

-unless MIXPANEL_ID.blank?
  javascript:  mixpanel.track("Display Page");

-content_for :javascript
  javascript:
    $(function() {
      let splitter = Object.create(ResizableSplitter);
      
      function applySplitter(mode=$('[data-layout-mode]').attr('data-layout-mode')) {
        const leftPanel = (mode === 'ltr' || mode === 'ttb')?'#leftColumn':'#rightColumn';
        const rightPanel = (mode === 'ltr' || mode === 'ttb')?'#rightColumn':'#leftColumn';
        
        if(splitter && splitter.destroy) {
          splitter.destroy()
        }
        
        splitter[(mode === 'ltr' || mode === 'rtl')?'initVertical':'initHorizontal']('#splitter', leftPanel, rightPanel, mode, {
          splitterContext: 'overview',
          onChanged: function() {
            // Trigger viewer to reset bounds after drag completes
            if (typeof viewer !== 'undefined') {
              requestAnimationFrame(() => {
                requestAnimationFrame(() => viewer.raiseEvent('reset-bounds'));
              });
            }
          },
          onPositionChange: function (pos) {
            window.localStorage.setItem('overviewSplitterPos', pos)
          },
          initialPosition: (window.localStorage.getItem('overviewSplitterPos') || 50) + '%'
        });
        
        // Trigger viewer to reset bounds after splitter initialization
        if (typeof viewer !== 'undefined') {
          requestAnimationFrame(() => viewer.raiseEvent('reset-bounds'));
        }
      }
      
      // initialize splitter when page loaded
      $(document).ready(function(){
        applySplitter($('[data-layout-mode]').attr('data-layout-mode'));
      })
    });
