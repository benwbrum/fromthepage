- metadata = @ai_transcription&.metadata
- has_tokens = metadata && (metadata['prompt_token_count'] || metadata['total_token_count'])
#token-usage{ class: has_tokens ? 'ai-token-usage' : nil }
  - if has_tokens
    h4 =t('.ai_token_usage')
    .token-usage-content
      - if metadata['prompt_token_count']
        p =t('.prompt_token_count', count: metadata['prompt_token_count'])
      - if metadata['candidates_token_count']
        p =t('.candidates_token_count', count: metadata['candidates_token_count'])
      - if metadata['total_token_count']
        p =t('.total_token_count', count: metadata['total_token_count'])
