=render({ :partial => '/shared/page_tabs', :locals => { :selected => 5, :page_id => @page.id }})

.page-headlines
  .headline
    h3.headline_title =t('.facsimile')
  .headline
    h3.headline_title =t('.ai_text')
    .page_info
      =t('.ai_generated_text')

-if @ai_accuracy_stats
  .ai-accuracy-statistics
    h4 =t('.accuracy_statistics')
    p.accuracy-explanation =t('.accuracy_explanation')

    .statistics-grid
      .stat-section
        h5 =t('.verbatim_comparison')
        p.section-description =t('.verbatim_description')

        .stat-item
          .stat-label
            =t('.character_error_rate')
            span.help-icon(title=t('.character_error_rate_tooltip')) ⓘ
          .stat-value
            =sprintf("%.2f%%", @ai_accuracy_stats[:verbatim][:cer])

        .stat-item
          .stat-label
            =t('.word_error_rate')
            span.help-icon(title=t('.word_error_rate_tooltip')) ⓘ
          .stat-value
            =sprintf("%.2f%%", @ai_accuracy_stats[:verbatim][:wer])

        .stat-item
          .stat-label
            =t('.non_stopword_accuracy')
            span.help-icon(title=t('.non_stopword_accuracy_tooltip')) ⓘ
          .stat-value
            =sprintf("%.2f%%", @ai_accuracy_stats[:verbatim][:non_stopword_accuracy])

      .stat-section
        h5 =t('.text_only_comparison')
        p.section-description =t('.text_only_description')

        .stat-item
          .stat-label
            =t('.character_error_rate')
            span.help-icon(title=t('.character_error_rate_tooltip')) ⓘ
          .stat-value
            =sprintf("%.2f%%", @ai_accuracy_stats[:text_only][:cer])

        .stat-item
          .stat-label
            =t('.word_error_rate')
            span.help-icon(title=t('.word_error_rate_tooltip')) ⓘ
          .stat-value
            =sprintf("%.2f%%", @ai_accuracy_stats[:text_only][:wer])

-elsif @page.has_ai_plaintext?
  .ai-accuracy-unavailable
    p.info-message =t('.statistics_unavailable')
    p =t('.statistics_unavailable_reason')

.page-columns(data-layout-mode="ltr")
  .page-column(id="leftColumn")
    .page-imagescan
      =render :partial => '/shared/osd_div'
  .splitter(id="splitter")
  .page-column(id="rightColumn")
    .page-preview[*language_attrs(@collection)]
      .ai-text-notice
        p.info-message =t('.ai_text_edit_notice')
      .ai-text-content
        pre.ai-plaintext =@page.ai_plaintext

-content_for :javascript
  javascript:
    let splitter = Object.create(ResizableSplitter);
    splitter.initVertical('#splitter', '#leftColumn', '#rightColumn');

