=render partial: '/shared/page_tabs', locals: { selected: 5, page_id: @page.id }

.page-headlines
  .headline
    h3.headline_title =t('.facsimile')
  .headline
    h3.headline_title =t('.ai_text')
    .page_info
      -if @page.ai_transcription.present?
        =t('.ai_text_generated_with', model: @page.ai_transcription.model, date: @page.ai_transcription.created_at.strftime("%B %e, %Y"))
      -else
        =t('.ai_generated_text')

=render partial: 'ai_text', locals: { ai_transcription: @page.ai_transcription }

-if @ai_accuracy_stats
  =render partial: 'cer_stats'

-elsif @page.ai_transcription.present?
  .ai-accuracy-unavailable
    p.info-message =t('.statistics_unavailable')
    p =t('.statistics_unavailable_reason')

-if @page.ai_transcription&.reasoning&.present?
  =render partial: 'reasoning', locals: { reasoning: @page.ai_transcription.reasoning }

-content_for :javascript
  =javascript_include_tag 'textdiff'
  javascript:
    let splitter = Object.create(ResizableSplitter);
    splitter.initVertical('#splitter', '#leftColumn', '#rightColumn');

    $(function() {
      if (!$('#show-diff-toggle').length) { return; }

      $('#ai-diff-content').hide();
      let diffInitialized = false;

      $('#show-diff-toggle').on('change', function() {
        if($(this).is(':checked')) {
          $('#ai-text-content').hide();
          $('#ai-diff-content').show();

          if (!diffInitialized) {
            $('.diff-versions')
            // apply prettyHTMLDiff for formatted html string
            .prettyHTMLDiff({
              changedContainer:  '[data-diff-transcription=changed] div.html-code',
              originalContainer: '[data-diff-transcription=original] div.html-code',
              diffContainer:     '[data-diff-transcription=original] div.html-code'
            });

            diffInitialized = true;
          }
        } else {
          $('#ai-text-content').show();
          $('#ai-diff-content').hide();
        }
      });
    });
