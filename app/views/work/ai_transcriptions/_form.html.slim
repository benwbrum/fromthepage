.collection-settings-wrapper
  table.form.collection-settings
    -if current_user.individual_researcher?
      tr
        td(colspan="2")
          h3
            =t('.ai_transcription')
          p =t('.contact_us', email: mail_to(SUPPORT_EMAIL)).html_safe
    -else
      tr
        td(colspan="2")
          h3
            =t('.ai_transcription')
          -if @not_started_transcriptions_count.positive? || @failed_transcriptions_count.positive?
            p =t('.description')
          -else
            p =t('.description_complete')
          div[style='margin: 5px 0']
            -if @not_started_transcriptions_count.positive?
              =link_to(collection_work_ai_transcriptions_path(collection.owner, collection, work), class: 'button action-btn', data: { turbo: true, turbo_method: :post }, style: 'margin-right: 10px;')
                span =t('.generate')

            -if @failed_transcriptions_count.positive?
              =link_to(collection_work_ai_transcriptions_path(collection.owner, collection, work), class: 'button action-btn', data: { turbo: true, turbo_method: :put }, style: 'margin-right: 10px;')
                span =t('.retry')

      tr
        td(colspan="2")
          =fe_stacked_bar(title: 'Pages', labels: [t('.finished'), t('.in_progress'), t('.failed'), t('.not_started')], \
            values: [@finished_transcriptions_count, @queued_transcriptions_count, @failed_transcriptions_count, @not_started_transcriptions_count], colors: AiTranscription::FE_COLOR_STATUSES.values, \
            options: { legend_position: 'bottom', tooltip_enabled: true, border_radius: 20 })

      tr
        td(colspan="2")
          section.collection-stats
            .collection-stats_counters
              .counter [data-prefix=@pages_count]
                =t('.pages')
            .collection-stats_counters
              .counter [data-prefix=@finished_transcriptions_count]
                =t('.finished')
              .counter [data-prefix=@queued_transcriptions_count]
                =t('.queued')
              .counter [data-prefix=@failed_transcriptions_count]
                =t('.failed')
              .counter [data-prefix=@not_started_transcriptions_count]
                =t('.not_started')
          -if @total_token_count.to_i > 0
            .collection-stats_counters
              .counter [data-prefix=@total_token_count]
                =t('.total_tokens_used')

      -if @failed_ai_transcriptions.present?
        tr
          td(colspan="2")
            h4 =t('.failed_transcription_errors')
            ul
              -@failed_ai_transcriptions.each do |ai_transcription|
                li
                  =link_to ai_transcription.page.title, collection_work_ai_transcription_error_path(collection.owner, collection, work, ai_transcription)
                  |  —
                  =ai_transcription.error_message.presence || t('.unknown_error')
            -if @failed_ai_transcriptions_hidden_count.positive?
              p =t('.failed_transcription_errors_hidden', count: @failed_ai_transcriptions_hidden_count)
