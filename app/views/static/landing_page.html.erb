<%= render "shared/landingheader" %>
<body>
    <%= render "shared/landingbodyheader" %>

    <div id="flash_wrapper">
        <% flash.each do |type, message| %>
            <%= render partial: 'shared/flash', locals: { type: type, message: message } %>
        <% end %>
    </div>

    <!-- Hero -->
    <section class="home-main">
        <div class="text">
            <h2 data-aos="zoom-in" data-aos-duration="800">Turn handwritten collections into searchable, accessible, structured text.</h2>
            <p data-aos="zoom-in" data-aos-duration="900">Collaborate with volunteers, staff, students, or responsible AI—all in one platform.</p>
            <div class="hero-cta" data-aos="zoom-in" data-aos-duration="1000">
                <a href="https://calendly.com/fromthepage/30-minute-meeting/" target="_blank" class="button">Schedule a Demo</a>
                <%= link_to 'Start a Free Trial', users_new_trial_path, class: 'button second' %>
            </div>
            <p class="volunteer-cta" data-aos="zoom-in" data-aos-duration="1100">
                Looking to volunteer instead? <%= link_to 'Find a project →', landing_page_path %>
            </p>
        </div>
    </section>
    <!-- Hero End -->

    <!-- Trusted By -->
    <section class="home-logos">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Trusted by</h2>
            <div class="row">
                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo01.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'500'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo02.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'600'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo03.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'700'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo04.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'800'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo05.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'900'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo06.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1000'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo07.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1100'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo08.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1200'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo09.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1300'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo10.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1400'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo11.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1500'}) %>
                </div>

                <div class="col-lg-2 col-md-3 col-3">
                    <%= image_tag("materials/logo12.png", data: { 'aos'=>'zoom-in', 'aos-duration'=>'1600'}) %>
                </div>
            </div>
        </div>
    </section>
    <!-- Trusted By End -->

    <!-- What can you do with FromThePage? -->
    <section class="home-services">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">What can you do with FromThePage?</h2>

            <div class="row">
                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="500">
                        <div class="icon">
                            <%= image_tag("materials/home-services01.png") %>
                        </div>
                        <div class="text">
                            <h4>Transcribe handwritten collections</h4>
                            <p>Bring manuscripts, letters, diaries, minute books, and other handwritten materials online. Work page by page with volunteers, staff, students, or AI drafts that stay under human review.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="600">
                        <div class="icon">
                            <%= image_tag("materials/home-services02.png") %>
                        </div>
                        <div class="text">
                            <h4>Extract structured data</h4>
                            <p>Turn ledgers, registers, forms, and other structured documents into searchable metadata and spreadsheets. Review and refine AI-generated fields before publishing or exporting.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="700">
                        <div class="icon">
                            <%= image_tag("materials/home-services03.png") %>
                        </div>
                        <div class="text">
                            <h4>Make collections accessible</h4>
                            <p>Create searchable text that supports screen readers, full-text search, and new accessibility requirements. Improve discoverability while preserving the original document alongside its transcription.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="800">
                        <div class="icon">
                            <%= image_tag("materials/home-services04.png") %>
                        </div>
                        <div class="text">
                            <h4>Collaborate with your community</h4>
                            <p>Invite volunteers, students, researchers, or staff to work together. FromThePage manages transcription, review, discussion, and progress tracking in one shared workspace.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="900">
                        <div class="icon">
                            <%= image_tag("materials/home-services09.png") %>
                        </div>
                        <div class="text">
                            <h4>Publish and integrate</h4>
                            <p>Share transcripts online, download PDFs and text files, export metadata, or connect with IIIF and other digital library systems. However you share your collections, FromThePage makes it easy to put your work to use.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="1000">
                        <div class="icon">
                            <%= image_tag("materials/home-services05.png") %>
                        </div>
                        <div class="text">
                            <h4>Unlock difficult collections</h4>
                            <p>Whether you're working with financial ledgers, logbooks, meeting minutes, multilingual manuscripts, or cross-written letters, FromThePage helps turn valuable collections into searchable, accessible resources.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- What can you do End -->

    <!-- Humans in Charge. AI as a Draft. -->
    <section class="home-ai">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Humans in Charge. AI as a Draft.</h2>
            <p class="subtitle" data-aos="zoom-in" data-aos-duration="900">AI can help cultural heritage institutions move faster, but handwritten collections still need human judgment. FromThePage uses AI to create editable drafts—not final transcripts—so volunteers, staff, students, and reviewers remain in control.</p>

            <div class="ai-screenshot-wrap" data-aos="zoom-in" data-aos-duration="800">
                <%= image_tag("materials/ai-draft-screenshot.png", alt: "AI draft workflow in FromThePage") %>
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="ai-annotations" aria-hidden="true">
                    <line x1="73.37" y1="13.63" x2="74" y2="18.5" stroke="#c9372c" stroke-width="0.4"/>
                    <ellipse cx="73.37" cy="11.33" rx="3.2" ry="2.3" fill="none" stroke="#c9372c" stroke-width="0.35"/>
                    <line x1="18.74" y1="5.56" x2="14" y2="16.5" stroke="#c9372c" stroke-width="0.4"/>
                    <ellipse cx="18.74" cy="3.86" rx="1.4" ry="1.7" fill="none" stroke="#c9372c" stroke-width="0.35"/>
                    <line x1="70.8" y1="24.3" x2="71" y2="30.5" stroke="#c9372c" stroke-width="0.4"/>
                    <rect x="45.0" y="19.4" width="50.9" height="4.9" rx="0.8" fill="none" stroke="#c9372c" stroke-width="0.35"/>
                </svg>
                <div class="ai-callout" style="top:18.5%; left:58%;">AI Draft button — transcribers choose when or if to use an AI draft</div>
                <div class="ai-callout" style="top:16.5%; left:1%;">AI tab — see the draft, compare to human edited transcription, view the model, prompt, reasoning and tokens</div>
                <div class="ai-callout" style="top:30.5%; left:56%;">Warning banner flags AI-generated text for review</div>
            </div>

            <div class="ai-steps-grid" data-aos="zoom-in" data-aos-duration="900">
                <div class="ai-step">
                    <div class="ai-step-num">01 &nbsp;Generate AI drafts</div>
                    <p>Create draft transcriptions or metadata for handwritten materials.</p>
                </div>
                <div class="ai-step">
                    <div class="ai-step-num">02 &nbsp;Review and edit</div>
                    <p>Volunteers, staff, students, or project reviewers correct the draft before publication.</p>
                </div>
                <div class="ai-step">
                    <div class="ai-step-num">03 &nbsp;Keep uncertainty visible</div>
                    <p>FromThePage uses models that are willing to be tentative rather than confidently inventing text.</p>
                </div>
                <div class="ai-step">
                    <div class="ai-step-num">04 &nbsp;Publish human-reviewed work</div>
                    <p>Final transcripts and metadata reflect your institution's standards, not an unchecked AI output.</p>
                </div>
            </div>

            <div class="ai-principles" data-aos="zoom-in" data-aos-duration="1000">
                <div class="ai-principles-label">Designed for responsible AI</div>
                <div class="ai-principles-items">
                    <div><strong>Optional</strong> — use when it fits</div>
                    <div><strong>Transparent</strong> — AI vs. human work</div>
                    <div><strong>Editable</strong> — every draft correctable</div>
                    <div><strong>Human-reviewed</strong> — people decide</div>
                </div>
            </div>
        </div>
    </section>
    <!-- AI Section End -->

    <!-- Every collection deserves to be accessible -->
    <section class="home-accessibility">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Every collection deserves to be accessible.</h2>
            <p class="subtitle" data-aos="zoom-in" data-aos-duration="900">Handwritten collections shouldn't be invisible to people who use screen readers—or to anyone searching your collections. FromThePage transforms handwritten materials into searchable text that supports accessibility, discovery, and research while preserving the original document alongside its transcription.</p>

            <div class="row">
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="600">
                    <div class="item">
                        <h4>Search</h4>
                        <p>Make handwritten collections searchable so researchers can find the people, places, and events they're looking for.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="700">
                    <div class="item">
                        <h4>Assistive Technologies</h4>
                        <p>Create text that works with assistive technologies while preserving the original document image.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="800">
                    <div class="item">
                        <h4>Reach More Readers</h4>
                        <p>Help more people use your collections, including those who can't read cursive or historical handwriting.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Accessibility End -->

    <!-- Bring people into the process -->
    <section class="home-community">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Bring people into the process.</h2>
            <p class="subtitle" data-aos="zoom-in" data-aos-duration="900">Every collection has people who care about it. FromThePage helps cultural heritage institutions involve volunteers, students, researchers, and community experts in creating, reviewing, and enriching handwritten collections.</p>

            <div class="community-photo-grid" data-aos="zoom-in" data-aos-duration="1000">
                <figure class="community-photo-figure community-photo-main">
                    <%= image_tag("materials/community-lva.jpg", alt: "Library of Virginia transcribathon") %>
                    <figcaption><span>Library of Virginia</span></figcaption>
                </figure>

                <div class="community-photo-stack">
                    <figure class="community-photo-figure">
                        <%= image_tag("materials/community-parker.png", alt: "Parker Library, Cambridge") %>
                        <figcaption><span>Parker Library, Cambridge</span></figcaption>
                    </figure>

                    <figure class="community-photo-figure community-photo-uva">
                        <%= image_tag("materials/community-uva.png", alt: "University of Virginia") %>
                        <figcaption><span>University of Virginia</span></figcaption>
                    </figure>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="600">
                    <div class="item">
                        <h4>Volunteers</h4>
                        <p>Invite the public to transcribe, review, and describe collections while building a community around your institution.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="700">
                    <div class="item">
                        <h4>Students</h4>
                        <p>Turn primary sources into hands-on learning experiences that contribute real work to your collections.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="800">
                    <div class="item">
                        <h4>Community Experts</h4>
                        <p>Welcome genealogists, language experts, subject specialists, and local history enthusiasts whose knowledge enriches your collections in ways technology alone cannot.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Community End -->

    <!-- Extract structured data -->
    <section class="home-structured">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Extract structured data.</h2>
            <p class="subtitle" data-aos="zoom-in" data-aos-duration="900">Some collections are more than documents—they're datasets. FromThePage helps transform handwritten ledgers, registers, forms, and other structured records into searchable metadata, indexes and spreadsheets that support discovery, digital collections, and new research.</p>

            <div class="structured-workflow" data-aos="zoom-in" data-aos-duration="1000">
                <figure class="structured-figure">
                    <%= image_tag("materials/structured-baptism.png", alt: "Handwritten register") %>
                    <figcaption><span>Ledger</span></figcaption>
                </figure>

                <div class="structured-arrow">→</div>

                <figure class="structured-figure structured-figure-register">
                    <%= image_tag("materials/structured-register.jpg", alt: "FromThePage transcription interface") %>
                    <figcaption><span>FromThePage transcription</span></figcaption>
                </figure>

                <div class="structured-arrow">→</div>

                <figure class="structured-figure">
                    <%= image_tag("materials/structured-export.png", alt: "Spreadsheet export") %>
                    <figcaption><span>Spreadsheet</span></figcaption>
                </figure>
            </div>

            <div class="row">
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="600">
                    <div class="item">
                        <h4>Ledgers</h4>
                        <p>Extract names, dates, commodities, locations, and other important fields from handwritten financial records and account books.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="700">
                    <div class="item">
                        <h4>Forms &amp; Registers</h4>
                        <p>Capture the fields you've defined from census records, parish registers, accession books, personnel records, index cards, and other field-based records.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="800">
                    <div class="item">
                        <h4>Metadata</h4>
                        <p>Create item metadata alongside your transcriptions, making it easier to organize, search, publish and share your collections.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Structured Data End -->

    <!-- Built for libraries and archives -->
    <section class="home-built">
        <div class="container">
            <h2 class="title" data-aos="zoom-in" data-aos-duration="800">Built for libraries and archives.</h2>
            <p class="subtitle" data-aos="zoom-in" data-aos-duration="900">FromThePage is designed specifically for cultural heritage collections—not generic documents. Because every institution has different systems and workflows, FromThePage emphasizes open standards, flexible metadata, and straightforward exports.</p>

            <div class="interop-diagram" data-aos="zoom-in" data-aos-duration="1000">
                <div class="interop-dashed-line"></div>

                <div class="interop-panel">
                    <span class="interop-label">Import</span>
                    <div class="interop-grid">
                        <div class="interop-chip"><span class="interop-badge">IMG</span><span>Images</span></div>
                        <div class="interop-chip"><span class="interop-badge">PDF</span><span>PDFs</span></div>
                        <div class="interop-chip"><span class="interop-badge">CDM</span><span>CONTENTdm</span></div>
                        <div class="interop-chip"><span class="interop-badge">IIIF</span><span>IIIF</span></div>
                    </div>
                </div>

                <div class="interop-center">FromThePage</div>

                <div class="interop-panel">
                    <span class="interop-label">Export</span>
                    <div class="interop-grid">
                        <div class="interop-chip"><span class="interop-badge">PDF</span><span>PDFs</span></div>
                        <div class="interop-chip"><span class="interop-badge">XLS</span><span>Spreadsheets</span></div>
                        <div class="interop-chip"><span class="interop-badge">TEI</span><span>TEI</span></div>
                        <div class="interop-chip"><span class="interop-badge">TXT</span><span>Plaintext</span></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="600">
                    <div class="item">
                        <h4>IIIF</h4>
                        <p>Import images from IIIF-compatible repositories and publish annotations back to your collections.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="700">
                    <div class="item">
                        <h4>Export</h4>
                        <p>Download transcripts, metadata, and structured data in formats that fit your workflow, from PDFs and spreadsheets to TEI and plain text.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-duration="800">
                    <div class="item">
                        <h4>APIs &amp; Metadata</h4>
                        <p>Connect FromThePage with your digital library, repository, or custom applications using APIs and flexible metadata.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Built for libraries End -->

    <!-- How Institutions Use FromThePage -->
    <section class="home-testimonials" data-aos="zoom-in" data-aos-duration="1000">
        <div class="container">
            <h2 class="title">How Institutions Use FromThePage</h2>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="loop">

                        <div class="box">
                            <div class="item">
                                <div class="case-study-header">
                                    <h4 class="case-study-institution">Library of Virginia</h4>
                                    <span class="case-study-subtitle">Turning handwritten forms into searchable data</span>
                                </div>
                                <p>The Library of Virginia's first structured transcription project was, in their words, "an absolute beast of a form"—118 lines with more than 200 fields. Together, we developed structured transcription that captured every field, increasing access and searchability while preserving the meaning of each record.</p>
                                <div class="case-study-footer">
                                    <%= image_tag("materials/lva_logo.svg", class: 'case-study-logo', alt: 'Library of Virginia') %>
                                    <a href="https://content.fromthepage.com/library-of-virginia/" target="_blank" class="case-study-link">Read their story <i class="fa fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="box">
                            <div class="item">
                                <div class="case-study-header">
                                    <h4 class="case-study-institution">Baylor University</h4>
                                    <span class="case-study-subtitle">Preserving history as civic engagement</span>
                                </div>
                                <blockquote>"Our college has introduced a new civic engagement requirement for all students."</blockquote>
                                <p>Baylor turned a freshman history course into a civic engagement project where students learned directly from primary sources while producing lasting work for the archive. By transcribing the minutes of the Evangelia Settlement House and reviewing one another's work, they created a resource that will benefit future researchers.</p>
                                <div class="case-study-footer">
                                    <%= image_tag("materials/baylorlogo.svg", class: 'case-study-logo', alt: 'Baylor University') %>
                                    <a href="https://content.fromthepage.com/an-interview-with-baylor-university/" target="_blank" class="case-study-link">Read their story <i class="fa fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="box">
                            <div class="item">
                                <div class="case-study-header">
                                    <h4 class="case-study-institution">Ayn Rand Archives</h4>
                                    <span class="case-study-subtitle">Accelerating transcription without compromising scholarship</span>
                                </div>
                                <blockquote>"There's a desire… to make sure that our transcripts are very accurate and authoritative. …some degree of human review is just probably always going to be part of our process."</blockquote>
                                <p>The Ayn Rand Archives adopted AI drafts to help volunteers move faster while maintaining scholarly standards. By keeping AI optional and every transcript subject to human review, they found a practical middle path between efficiency and accuracy.</p>
                                <div class="case-study-footer">
                                    <%= image_tag("materials/aynrand-logo.png", class: 'case-study-logo', alt: 'Ayn Rand Archives') %>
                                    <a href="https://fromthepage.com/case-studies/ayn-rand-institute" target="_blank" class="case-study-link">Read their story <i class="fa fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="box">
                            <div class="item">
                                <div class="case-study-header">
                                    <h4 class="case-study-institution">The National Archives (UK)</h4>
                                    <span class="case-study-subtitle">Volunteers improving the historical record</span>
                                </div>
                                <blockquote>"Our methodology and practical approach to cataloguing this collection has been directly informed by the experience of using FromThePage and the valuable feedback of volunteers."</blockquote>
                                <p>Volunteers from around the world helped The National Archives transcribe and catalog historical records while improving the archive itself. Together, they expanded catalog records, uncovered new historical connections, and made previously difficult-to-search collections accessible to researchers.</p>
                                <div class="case-study-footer">
                                    <%= image_tag("materials/logo10.png", class: 'case-study-logo', alt: 'The National Archives (UK)') %>
                                    <a href="https://content.fromthepage.com/an-interview-with-the-national-archives-uk/" target="_blank" class="case-study-link">Read their story <i class="fa fa-angle-right"></i></a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Case Studies End -->

    <!-- Stats -->
    <section class="home-count">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="800">
                        <h4>Transcribers</h4>
                        <% cache('landing_page/transcribers_count', expires_in: 1.day) do %>
                            <p><%= Deed.where(created_at: (1.year.ago)..).select(:user_id).distinct.count %></p>
                        <% end %>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="900">
                        <h4>Active Projects</h4>
                        <p><%= Collection.joins(:owner).where("users.account_type" => ["Small Organization", "Individual Researcher", "Large Institution"]).where("users.owner" => true).where(is_active: true).count %></p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="1000">
                        <h4>Pages Transcribed</h4>
                        <% cache('landing_page/pages_transcribed_count', expires_in: 10.minutes) do %>
                            <p><%= number_with_delimiter Page.where.not(status: :new).count %></p>
                        <% end %>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <div class="item" data-aos="zoom-in" data-aos-duration="1100">
                        <h4>Institutions</h4>
                        <p><%= User.where(account_type: ["Small Organization", "Individual Researcher", "Large Institution"]).where(owner: true).count %></p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Stats End -->

    <!-- Bottom CTA -->
    <section class="home-start">
        <div class="container">
            <div class="text">
                <h4>Ready to unlock your handwritten collections?</h4>
                <p>Whether you're starting with a single manuscript or an entire archive, we're here to help you unlock the value of your handwritten collections.</p>

                <div class="row justify-content-center cta-boxes">
                    <div class="col-lg-5 col-md-6">
                        <div class="cta-box">
                            <h5>Talk With Us</h5>
                            <p>Discuss your project with the people who built FromThePage.</p>
                            <ul>
                                <li>Advice tailored to your collections</li>
                                <li>AI, crowdsourcing, accessibility, and workflow guidance</li>
                            </ul>
                            <a href="https://calendly.com/fromthepage/30-minute-meeting/" target="_blank" class="button">Talk With Us</a>
                        </div>
                    </div>

                    <div class="col-lg-5 col-md-6">
                        <div class="cta-box">
                            <h5>Start a Free Trial</h5>
                            <p>Try FromThePage with your own collection.</p>
                            <ul>
                                <li>Up to 200 images</li>
                                <li>No credit card required</li>
                            </ul>
                            <%= link_to 'Start a Free Trial', users_new_trial_path, class: 'button second' %>
                        </div>
                    </div>
                </div>

                <p class="volunteer-cta">
                    Looking to volunteer instead? <%= link_to 'Find a project →', landing_page_path %>
                </p>
            </div>
        </div>
    </section>
    <!-- Bottom CTA End -->

    <%= render "shared/landingfooter" %>

</body>

</html>
