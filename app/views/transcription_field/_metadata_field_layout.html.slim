-metadata_field_order(@collection)
-@fields.each do |line, array|
  -page_number = array.map{|field| field.page_number}.uniq.first
  .fields-row
    -field_layout(array)
    -@field_array.each do |field, cell|
      -span_width = !field.percentage.blank? ? field.percentage : @width
      .field-wrapper(style="width: #{span_width}%")
        -if field.input_type == "instruction"
          div id="fields[#{field.id}][#{field.label}]" class="field-instructions"
            h5 =t('.instructions')
            p ==field.label
        -else
          =label_tag field.label, field.label
          -if (defined? owner_preview) && owner_preview
            -cell=nil
          -else
            -if @field_preview && @field_preview[field.id]
              -cell = @field_preview[field.id].first
            -else
              -cell = @metadata_array.detect{|element| element["transcription_field_id"] == field.id}
          -content = cell.nil? ? nil : cell['value']
          -if field.input_type == "text"
            =text_field_tag "fields[#{field.id}][#{field.label}]", content, class: 'field-input'
          -elsif field.input_type == "date"
            =text_field_tag "fields[#{field.id}][#{field.label}]", content, class: 'field-input edtf', data: { inputmask: '"alias": "datetime", "inputFormat": "isoDate"'}
          -elsif field.input_type == "select"
            -options = field.options.split(";").map{|option| option.strip} unless field.options.nil?
            =select_tag("fields[#{field.id}][#{field.label}]", options_for_select(options, content), class: 'field-input')
          -elsif field.input_type == "multiselect"
            / add aria label
            / figure out the data attributes
            -if field.options
              -options = field.options.split("\n").map{ |e| e.chomp } unless field.options.nil?
            -else
              -options=[]
            =select_tag("fields[#{field.id}][#{field.label}]", options_for_select(options, content), class: 'field-input', data: { controller: 'select2', select2_placeholder_value: 'Choose...' }, size: 1, multiple: true)
          -elsif field.input_type == "description"
            =hidden_field_tag "fields[#{field.id}][#{field.label}]", content, class: 'field-input'
          -elsif field.input_type == "alt text"
            =text_area_tag "fields[#{field.id}][#{field.label}]", content, class: 'field-input alt-text', maxlength: '255'
            div.character-count
          -else
            =text_area_tag "fields[#{field.id}][#{field.label}]", content, class: 'field-input'

-if @work&.ai_metadata_draft_available?
  -content_for :javascript
    javascript:
      var aiMetadataDraftByEngine = #{{@work.finished_ai_work_metadata_by_engine.transform_values { |m| m.metadata_json || {} }.to_json}};
      var aiMetadataDraftModelNames = #{{@work.finished_ai_work_metadata_by_engine.transform_values(&:model).to_json}};
      var aiMetadataDraftBothAgreeText = #{{t('.ai_both_agree').to_json}};
      var aiMetadataDraftDisagreeHeaderText = #{{t('.ai_disagree_header').to_json}};
      var aiMetadataDraftOptionPlaceholder = #{{t('.ai_option_placeholder').to_json}};

      document.getElementById('ai-draft-metadata-fields').addEventListener('click', function() {
        var engineKeys = Object.keys(aiMetadataDraftByEngine).sort();

        function escapeHtml(str) {
          return String(str).replace(/[&<>"']/g, function(ch) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
          });
        }

        function displayString(value) {
          return Array.isArray(value) ? value.join(', ') : String(value);
        }

        function serializeValue(value) {
          return Array.isArray(value) ? value.map(String).slice().sort().join('|') : String(value).trim();
        }

        // Word-level diff via LCS, used to highlight the differing words between two AI suggestions.
        function diffWords(a, b) {
          var aw = a.split(/\s+/).filter(Boolean);
          var bw = b.split(/\s+/).filter(Boolean);
          var n = aw.length, m = bw.length;
          var dp = [];
          for (var i = 0; i <= n; i++) { dp.push(new Array(m + 1).fill(0)); }
          for (i = n - 1; i >= 0; i--) {
            for (var j = m - 1; j >= 0; j--) {
              dp[i][j] = aw[i] === bw[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
            }
          }
          var ai = 0, bi = 0, aOut = [], bOut = [];
          while (ai < n && bi < m) {
            if (aw[ai] === bw[bi]) {
              aOut.push({ text: aw[ai], changed: false });
              bOut.push({ text: bw[bi], changed: false });
              ai++; bi++;
            } else if (dp[ai + 1][bi] >= dp[ai][bi + 1]) {
              aOut.push({ text: aw[ai], changed: true });
              ai++;
            } else {
              bOut.push({ text: bw[bi], changed: true });
              bi++;
            }
          }
          while (ai < n) { aOut.push({ text: aw[ai], changed: true }); ai++; }
          while (bi < m) { bOut.push({ text: bw[bi], changed: true }); bi++; }
          return [aOut, bOut];
        }

        function renderTokens(tokens) {
          return tokens.map(function(tok) {
            var escaped = escapeHtml(tok.text);
            return tok.changed ? '<b class="ai-diff-word">' + escaped + '</b>' : escaped;
          }).join(' ');
        }

        // See app/views/transcription_field/_field_layout.html.slim for the equivalent
        // page-transcription implementation: notes/panels for a whole .fields-row are collected
        // and placed into one shared, absolutely-positioned container right after the row so that
        // several fields' notes on one row sit side by side rather than stacking on top of each other.
        $('.fields-row').each(function() {
          var $row = $(this);
          var rowLeft = $row.offset().left;
          $row.nextUntil('.fields-row', '.ai-draft-notes-row').remove();

          var notes = [];

          $row.find('.field-wrapper .field-input').each(function() {
            var $field = $(this);
            var match = /^fields\[(\d+)\]/.exec($field.attr('name'));
            if (!match) return;
            var fieldId = match[1];
            var $wrapper = $field.closest('.field-wrapper');
            var isMultiselect = $field.is('select[multiple]');
            $field.removeClass('ai-draft-agree ai-draft-disagree-input');

            var valuesByEngine = {};
            engineKeys.forEach(function(engine) {
              var value = aiMetadataDraftByEngine[engine][fieldId];
              if (isMultiselect) {
                if (Array.isArray(value) && value.length > 0) { valuesByEngine[engine] = value; }
              } else if (value !== undefined && value !== null && value !== '') {
                valuesByEngine[engine] = value;
              }
            });

            var presentEngines = Object.keys(valuesByEngine);
            if (presentEngines.length === 0) return;

            function applyValue(engine) {
              if (isMultiselect) {
                $field.val(valuesByEngine[engine]).trigger('change');
              } else {
                $field.val(valuesByEngine[engine]).trigger('input').trigger('change');
              }
            }

            if (presentEngines.length === 1) {
              applyValue(presentEngines[0]);
              return;
            }

            var firstSerialized = serializeValue(valuesByEngine[presentEngines[0]]);
            var allAgree = presentEngines.every(function(engine) {
              return serializeValue(valuesByEngine[engine]) === firstSerialized;
            });

            if (allAgree) {
              applyValue(presentEngines[0]);
              // select2-backed multiselects render their own widget over the hidden <select>, so
              // highlighting the hidden element directly wouldn't be visible to the user.
              if (!isMultiselect) { $field.addClass('ai-draft-agree'); }
              notes.push({ kind: 'agree', wrapper: $wrapper });
              return;
            }

            if (!isMultiselect) {
              $field.addClass('ai-draft-disagree-input');
              if ($field.is('input[type="text"], textarea') && !$field.val()) {
                $field.attr('placeholder', aiMetadataDraftOptionPlaceholder);
              }
            }

            notes.push({
              kind: 'disagree',
              field: $field,
              wrapper: $wrapper,
              valuesByEngine: valuesByEngine,
              presentEngines: presentEngines
            });
          });

          if (notes.length === 0) return;

          var $notesRow = $('<div class="ai-draft-notes-row"></div>');
          $row.after($notesRow);

          notes.forEach(function(entry) {
            var left = (entry.wrapper.offset().left - rowLeft) + 'px';
            var width = entry.wrapper.outerWidth() + 'px';

            if (entry.kind === 'agree') {
              var $status = $('<div class="ai-draft-status ai-draft-status-agree">&#10003; ' + escapeHtml(aiMetadataDraftBothAgreeText) + '</div>');
              $status.css({ left: left, width: width });
              $notesRow.append($status);
              return;
            }

            var $field = entry.field;
            var presentEngines = entry.presentEngines;
            var valuesByEngine = entry.valuesByEngine;
            var isArrayValues = presentEngines.some(function(engine) { return Array.isArray(valuesByEngine[engine]); });

            var diffTokens = (!isArrayValues && presentEngines.length === 2)
              ? diffWords(displayString(valuesByEngine[presentEngines[0]]), displayString(valuesByEngine[presentEngines[1]]))
              : null;

            var $panel = $('<div class="ai-draft-disagree"></div>');
            $panel.css({ left: left, width: width });
            $panel.append(
              '<div class="ai-draft-disagree-header">&#9888; ' + escapeHtml(aiMetadataDraftDisagreeHeaderText) + '</div>'
            );

            presentEngines.forEach(function(engine, idx) {
              var value = valuesByEngine[engine];
              var html = diffTokens ? renderTokens(diffTokens[idx]) : escapeHtml(displayString(value));
              var $option = $('<div class="ai-draft-option" tabindex="0" role="button"></div>');
              var modelName = aiMetadataDraftModelNames[engine] || engine;
              $option.append('<span class="ai-draft-option-text">' + html + '</span>');
              $option.append('<span class="ai-draft-option-label">' + escapeHtml(modelName) + '</span>');
              $option.on('click', function() {
                if ($field.is('select[multiple]')) {
                  $field.val(value).trigger('change');
                } else {
                  $field.val(value).trigger('input').trigger('change');
                }
                $panel.find('.ai-draft-option').removeClass('selected');
                $option.addClass('selected');
              });
              $option.on('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  $option.trigger('click');
                }
              });
              $panel.append($option);
            });

            $notesRow.append($panel);
          });

          // Notes/panels are positioned absolutely (so several sitting side by side in the same row
          // don't stack on top of each other), which takes them out of normal flow — give their
          // shared container an explicit height so it still pushes the next .fields-row down instead
          // of being overlapped.
          var maxNoteHeight = 0;
          $notesRow.children().each(function() {
            maxNoteHeight = Math.max(maxNoteHeight, $(this).outerHeight());
          });
          $notesRow.css('height', maxNoteHeight + 'px');
        });

        $('#ai-draft-metadata-fields').prop('disabled', true);
      });

-content_for :javascript
  javascript:
    function countChars() {
      var chars = $(this).val().length
      $(this).next().text(chars + " / 180");

      if (chars > 180) {
        $(this).css('background-color', '#F5B7AC');
      } else if (chars > 140) {
        $(this).css('background-color', '#FEDFC9');
      } else if (chars > 125) {
        $(this).css('background-color', '#FFF6CC');
      } else {
        $(this).css('background-color', '');
      }
    }

    $('.alt-text').on('input', countChars);
    $('document').ready(function() {
      $('.alt-text').each(function() {
        countChars.call($(this));
      });
    });
    $('.edtf').inputmask();
